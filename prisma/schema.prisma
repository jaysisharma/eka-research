generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String              @id @default(cuid())
  name              String
  email             String              @unique
  password          String
  role              String              @default("FREE_USER")
  requestedRole     String?
  level             String?
  interest          String?
  emailVerified       Boolean             @default(false)
  verificationOtp     String?
  otpExpiry           DateTime?
  passwordResetToken  String?
  resetTokenExpiry    DateTime?
  loginAttempts       Int                 @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  orders              Order[]
  subscription        Subscription?
  registrations       EventRegistration[]
  researchSubmissions ResearchArticle[]
}

model Order {
  id        String      @id @default(cuid())
  userId    String?
  user      User?       @relation(fields: [userId], references: [id])
  name      String
  email     String
  phone     String?
  address   String
  district  String
  province  String
  notes     String?
  totalNpr  Int
  status    String      @default("pending")
  items     OrderItem[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model OrderItem {
  id        String       @id @default(cuid())
  orderId   String
  order     Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   StoreProduct @relation(fields: [productId], references: [id], onDelete: Restrict)
  name      String
  priceNpr  Int
  quantity  Int
  variant   String?
}

model NewsPost {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  excerpt   String
  category  String
  date      String
  imageUrl  String?
  href      String
  featured  Boolean  @default(false)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ResearchArticle {
  id                   String   @id @default(cuid())
  title                String
  abstract             String
  type                 String                         // journal | conference | preprint | report
  publicationStatus    String   @default("draft")    // draft | under_review | accepted | published

  // Authors
  authors              String                         // JSON string[]  — external authors, one per line
  internalContributors String   @default("[]")        // JSON string[]  — user IDs of EKA contributors

  // Publication
  journal              String   @default("")
  publicationDate      String   @default("")          // "YYYY-MM-DD" or human-readable
  year                 Int      @default(0)           // derived from publicationDate on save
  doi                  String?
  arxiv                String?

  // Classification
  disciplines          String   @default("[]")        // JSON string[]

  // Files & links
  pdfUrl               String?  // stored path or external URL
  externalUrl          String?  // canonical paper link
  githubUrl            String?
  datasetUrl           String?

  // Legacy / compat
  ekaAuthors           String   @default("[]")
  imageUrl             String?
  date                 String   @default("")

  // Full paper content (markdown)
  content              String?  // full body written in admin editor

  // Visibility
  featured             Boolean  @default(false)
  published            Boolean  @default(true)
  isPremium            Boolean  @default(false)

  // Admin workflow
  submittedBy          String?
  submitter            User?    @relation(fields: [submittedBy], references: [id], onDelete: SetNull)
  submissionStatus     String   @default("approved")  // pending | approved | rejected

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model Event {
  id               String              @id @default(cuid())
  slug             String?             @unique
  title            String
  description      String
  type             String
  date             String
  time             String
  location         String
  locationDetail   String?
  seats            Int?
  seatsLeft        Int?
  href             String
  registrationHref String?
  published        Boolean             @default(true)
  featured         Boolean             @default(false)
  registrations    EventRegistration[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
}

model EventRegistration {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  name      String
  email     String
  phone     String?
  message   String?
  status    String   @default("confirmed")
  createdAt DateTime @default(now())
}

model StoreProduct {
  id          String      @id @default(cuid())
  slug        String      @unique
  name        String
  tagline     String
  category    String
  priceNpr    Int
  description String
  includes    String?
  variants    String?
  badge       String?
  inStock     Boolean     @default(true)
  digital     Boolean     @default(false)
  imageUrl    String?
  gradient    String      @default("linear-gradient(135deg, #1a2060 0%, #0a0d22 100%)")
  orderItems  OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model ProjectCategory {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  projects  Project[]
  createdAt DateTime  @default(now())
}

model Project {
  id           String          @id @default(cuid())
  title        String
  description  String
  status       String
  categoryId   String
  category     ProjectCategory @relation(fields: [categoryId], references: [id])
  period       String
  tags         String
  imageUrl     String?
  images       String          @default("[]")
  href         String
  featured     Boolean         @default(false)
  outcome      String?
  phase        String?
  launchTarget String?
  published    Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

model Subscription {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan      String
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContactMessage {
  id           String   @id @default(cuid())
  name         String
  email        String
  topic        String
  organisation String?
  message      String
  read         Boolean  @default(false)
  createdAt    DateTime @default(now())
}

// ── Opportunities ────────────────────────────────────────────────────────────

enum VacancyType {
  FULL_TIME
  PART_TIME
  INTERNSHIP
  VOLUNTEER
}

enum VacancyStatus {
  DRAFT
  OPEN
  CLOSED
}

model Vacancy {
  id           String               @id @default(cuid())
  title        String
  type         VacancyType
  department   String
  description  String
  deadline     DateTime?
  status       VacancyStatus        @default(DRAFT)
  applications VacancyApplication[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
}

model VacancyApplication {
  id        String   @id @default(cuid())
  vacancyId String
  vacancy   Vacancy  @relation(fields: [vacancyId], references: [id], onDelete: Cascade)
  name      String
  email     String
  phone     String?
  message   String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([vacancyId])
}

model Mentor {
  id        String   @id @default(cuid())
  name      String
  expertise String
  bio       String?
  imageUrl  String?
  linkedIn  String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MentoringProgram {
  id           String                 @id @default(cuid())
  description  String
  duration     String
  structure    String?
  nextCohort   DateTime?
  isOpen       Boolean                @default(false)
  applications MentoringApplication[]
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
}

model MentoringApplication {
  id         String           @id @default(cuid())
  programId  String
  program    MentoringProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  name       String
  email      String
  phone      String?
  background String?
  goals      String?
  read       Boolean          @default(false)
  createdAt  DateTime         @default(now())

  @@index([programId])
}

model TeamMember {
  id        String   @id @default(cuid())
  name      String
  role      String
  bio       String
  imageUrl  String?
  featured  Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GalleryImage {
  id          String   @id @default(cuid())
  title       String
  description String?  @db.Text
  imageUrl    String
  category    String   @default("astrophotography") // astrophotography | research | facilities | community
  featured    Boolean  @default(false)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Partner {
  id        String   @id @default(cuid())
  name      String
  logoUrl   String?
  website   String?
  featured  Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}



